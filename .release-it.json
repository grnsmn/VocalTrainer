{
    "git": {
        "commitMessage": "chore: release v${version}",
        "tagName": "v${version}",
        "requireCleanWorkingDir": false
    },
    "npm": {
        "publish": false
    },
    "github": {
        "release": false
    },
    "ci": true,
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": "angular",
            "infile": "CHANGELOG.md"
        }
    },
    "hooks": {
        "after:bump": "node scripts/expo-version-bumper.js ${version}"
    }
}